{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Isotype waffle: 100 children, 45 of whom play outdoors most days (RCH National Child Health Poll, 2022).",
  "width": "container",
  "height": 240,
  "data": {
    "sequence": {
      "start": 0,
      "stop": 100,
      "as": "i"
    }
  },
  "params": [
    {
      "name": "share",
      "value": 45
    }
  ],
  "transform": [
    {
      "calculate": "floor(datum.i / 5)",
      "as": "col"
    },
    {
      "calculate": "datum.i % 5",
      "as": "row"
    },
    {
      "calculate": "datum.i < share ? 'Plays outdoors most days' : 'Does not'",
      "as": "group"
    }
  ],
  "mark": {
    "type": "point",
    "shape": "M-0.3,-0.72 a0.28,0.28 0 1,1 0.56,0 a0.28,0.28 0 1,1 -0.56,0 Z M-0.55,-0.32 L0.55,-0.32 L0.42,0.35 L0.24,0.35 L0.24,1 L0.04,1 L0.04,0.42 L-0.04,0.42 L-0.04,1 L-0.24,1 L-0.24,0.35 L-0.42,0.35 Z",
    "filled": true,
    "size": 1150,
    "strokeWidth": 0
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Plays outdoors most days",
          "Does not"
        ],
        "range": [
          "#2e7d4f",
          "#c3ccbf"
        ]
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal",
        "symbolType": "square",
        "labelFontSize": 13
      }
    },
    "tooltip": [
      {
        "field": "group",
        "title": "This child"
      }
    ]
  }
}

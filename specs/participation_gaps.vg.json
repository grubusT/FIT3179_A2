{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Small multiples: share of adults active at least once a week, by income, education, disability and Indigenous status (AusPlay 2025).",
  "data": {
    "url": "data/participation_gaps_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "yearly": "number",
        "weekly": "number"
      }
    }
  },
  "transform": [
    {
      "filter": {
        "field": "category",
        "oneOf": [
          "Annual household income~^",
          "Highest education completed",
          "Disability or physical condition that restricts life in some way^",
          "Aboriginal or Torres Strait Islander origin^"
        ]
      }
    },
    {
      "filter": "indexof(['Not stated','Other','Still at secondary school','Refused / don\\'t know'], datum.group) < 0"
    },
    {
      "calculate": "{'Annual household income~^':'Household income','Highest education completed':'Highest education','Disability or physical condition that restricts life in some way^':'Disability','Aboriginal or Torres Strait Islander origin^':'First Nations'}[datum.category]",
      "as": "panel"
    },
    {
      "calculate": "{'University degree or higher (including postgraduate diploma)':'University degree','Undergraduate diploma or associate diploma':'Diploma','Certificate, trade qualification or apprenticeship':'Trade or certificate','Highest level of secondary school':'Finished Year 12','Did not complete highest level of school':'Left school early','Yes':'Yes','No':'No'}[datum.group] || datum.group",
      "as": "label"
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "weekly",
          "as": "lo"
        },
        {
          "op": "max",
          "field": "weekly",
          "as": "hi"
        }
      ],
      "groupby": [
        "panel"
      ]
    },
    {
      "calculate": "datum.weekly == datum.lo ? 'low' : datum.weekly == datum.hi ? 'high' : 'mid'",
      "as": "tone"
    },
    {
      "calculate": "datum.tone == 'low' ? format(datum.weekly, '.0f') + '%, ' + format(datum.hi - datum.lo, '.0f') + ' points behind' : format(datum.weekly, '.0f') + '%'",
      "as": "vlabel"
    }
  ],
  "facet": {
    "field": "panel",
    "type": "nominal",
    "title": null,
    "sort": [
      "Household income",
      "Highest education",
      "Disability",
      "First Nations"
    ],
    "header": {
      "labelFontSize": 15,
      "labelFontWeight": 700,
      "labelColor": "#1e2b24",
      "labelAnchor": "start",
      "labelPadding": 8
    }
  },
  "columns": 2,
  "spec": {
    "width": 370,
    "height": {
      "step": 36
    },
    "encoding": {
      "y": {
        "field": "label",
        "type": "nominal",
        "title": null,
        "sort": null,
        "axis": {
          "domain": false,
          "ticks": false,
          "labelFontSize": 13,
          "minExtent": 150,
          "maxExtent": 150
        }
      },
      "x": {
        "field": "weekly",
        "type": "quantitative",
        "title": "% active at least once a week",
        "scale": {
          "domain": [
            0,
            100
          ]
        },
        "axis": {
          "values": [
            0,
            25,
            50,
            75,
            100
          ],
          "grid": true
        }
      }
    },
    "layer": [
      {
        "mark": {
          "type": "bar",
          "cornerRadiusEnd": 3,
          "height": {
            "band": 0.7
          }
        },
        "encoding": {
          "color": {
            "field": "tone",
            "legend": null,
            "scale": {
              "domain": [
                "low",
                "mid",
                "high"
              ],
              "range": [
                "#a8462e",
                "#b7c6b4",
                "#2e7d4f"
              ]
            }
          },
          "tooltip": [
            {
              "field": "panel",
              "title": "Grouped by"
            },
            {
              "field": "label",
              "title": "Group"
            },
            {
              "field": "weekly",
              "title": "% active weekly"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "text",
          "align": "left",
          "dx": 6,
          "fontSize": 13,
          "fontWeight": 700
        },
        "encoding": {
          "text": {
            "field": "vlabel"
          },
          "color": {
            "condition": {
              "test": "datum.tone == 'low'",
              "value": "#a8462e"
            },
            "value": "#1e2b24"
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "spacing": {
    "row": 40,
    "column": 60
  }
}

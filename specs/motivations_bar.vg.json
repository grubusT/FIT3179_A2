{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Ranked bar chart of the top 10 reasons Australians give for being active, with an age-group menu (AusPlay 2025).",
  "width": "container",
  "height": {
    "step": 30
  },
  "data": {
    "url": "data/motivations_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "share": "number"
      }
    }
  },
  "params": [
    {
      "name": "Age",
      "value": "Total",
      "bind": {
        "input": "select",
        "options": [
          "Total",
          "15-17",
          "18-24",
          "25-34",
          "35-44",
          "45-54",
          "55-64",
          "65+"
        ],
        "labels": [
          "All adults",
          "15 to 17",
          "18 to 24",
          "25 to 34",
          "35 to 44",
          "45 to 54",
          "55 to 64",
          "65 and over"
        ],
        "name": "Show age group  "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.sex == 'All' && datum.age == Age"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "r"
        }
      ],
      "sort": [
        {
          "field": "share",
          "order": "descending"
        }
      ]
    },
    {
      "filter": "datum.r <= 10"
    },
    {
      "calculate": "{'Physical health or fitness':'Fitness','Fun/enjoyment':'Fun','To lose weight/ keep weight off/tone':'Weight','To be outdoors/to enjoy nature':'Being outdoors','Social reasons':'Social','Psychological/ mental health/ therapy':'Mental health','Sense of achievement':'Achievement','Hobby':'Hobby','Walk the dog':'Walk the dog','Training purposes':'Training','Learn a new skill':'Learn a new skill','Performance or competition':'Competition','Way of getting around':'Getting around','Physio/rehab/ physical therapy/post-op':'Rehab','To be a good role model':'Role model','Professional/ part of my job':'For work'}[datum.motivation]",
      "as": "label"
    },
    {
      "calculate": "datum.label == 'Being outdoors'",
      "as": "nature"
    }
  ],
  "encoding": {
    "y": {
      "field": "label",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "share",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 13,
        "labelPadding": 8,
        "labelColor": {
          "condition": {
            "test": "datum.value == 'Being outdoors'",
            "value": "#2e7d4f"
          },
          "value": "#1e2b24"
        },
        "labelFontWeight": {
          "condition": {
            "test": "datum.value == 'Being outdoors'",
            "value": 700
          },
          "value": 400
        }
      }
    },
    "x": {
      "field": "share",
      "type": "quantitative",
      "title": "% of active adults",
      "scale": {
        "domain": [
          0,
          80
        ]
      },
      "axis": {
        "values": [
          0,
          20,
          40,
          60,
          80
        ],
        "grid": true
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3,
        "height": {
          "band": 0.72
        }
      },
      "encoding": {
        "color": {
          "field": "nature",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              true,
              false
            ],
            "range": [
              "#2e7d4f",
              "#b7c6b4"
            ]
          }
        },
        "tooltip": [
          {
            "field": "motivation",
            "title": "Reason"
          },
          {
            "field": "share",
            "title": "% of active adults"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 12.5,
        "fontWeight": 700,
        "color": "#1e2b24"
      },
      "encoding": {
        "text": {
          "field": "share",
          "format": ".0f"
        }
      }
    }
  ]
}

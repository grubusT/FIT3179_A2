{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Parallel coordinates: each line is a state, each upright axis an outdoor activity. Every axis starts at 0% and tops out at the leading state (AusPlay 2025).",
  "width": "container",
  "height": 340,
  "data": {
    "url": "data/state_outdoor_activity_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "rate": "number",
        "participants": "number"
      }
    }
  },
  "params": [
    {
      "name": "hl",
      "value": "TAS",
      "bind": {
        "input": "select",
        "options": [
          "TAS",
          "ACT",
          "NSW",
          "VIC",
          "QLD",
          "SA",
          "WA",
          "NT"
        ],
        "labels": [
          "Tasmania",
          "ACT",
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Northern Territory"
        ],
        "name": "Highlight a state  "
      }
    }
  ],
  "transform": [
    {
      "filter": {
        "field": "activity",
        "oneOf": [
          "Bush walking",
          "Cycling",
          "Mountain biking",
          "Canoeing/Kayaking",
          "Surfing",
          "Fishing (recreational)"
        ]
      }
    },
    {
      "calculate": "replace(replace(replace(datum.activity, 'Bush walking', 'Bushwalking'), 'Fishing (recreational)', 'Fishing'), 'Canoeing/Kayaking', 'Canoe & kayak')",
      "as": "axis"
    },
    {
      "calculate": "indexof([\"Bushwalking\", \"Cycling\", \"Mountain biking\", \"Canoe & kayak\", \"Surfing\", \"Fishing\"], datum.axis)",
      "as": "axis_i"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "rate",
          "as": "hi"
        }
      ],
      "groupby": [
        "activity"
      ]
    },
    {
      "calculate": "datum.rate / datum.hi",
      "as": "norm"
    },
    {
      "calculate": "datum.state == hl",
      "as": "on"
    }
  ],
  "encoding": {
    "x": {
      "field": "axis",
      "type": "nominal",
      "title": null,
      "sort": [
        "Bushwalking",
        "Cycling",
        "Mountain biking",
        "Canoe & kayak",
        "Surfing",
        "Fishing"
      ],
      "scale": {
        "padding": 0.25
      },
      "axis": {
        "orient": "top",
        "domain": false,
        "ticks": false,
        "labelAngle": 0,
        "labelPadding": 26,
        "labelFontSize": 13.5,
        "labelFontWeight": 600,
        "labelColor": "#1e2b24",
        "grid": true,
        "gridColor": "#9aa79a",
        "gridWidth": 1.5
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#b3c0b1",
        "strokeWidth": 1.6
      },
      "encoding": {
        "y": {
          "field": "norm",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "detail": {
          "field": "state"
        },
        "order": {
          "field": "axis_i"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 34,
        "color": "#a7b5a5"
      },
      "encoding": {
        "y": {
          "field": "norm",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },
          {
            "field": "axis",
            "title": "Activity"
          },
          {
            "field": "rate",
            "title": "% of adults"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.on"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#d0901f",
        "strokeWidth": 4
      },
      "encoding": {
        "y": {
          "field": "norm",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "order": {
          "field": "axis_i"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.on"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 110,
        "color": "#d0901f",
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "y": {
          "field": "norm",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },
          {
            "field": "axis",
            "title": "Activity"
          },
          {
            "field": "rate",
            "title": "% of adults"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.on"
        },
        {
          "calculate": "format(datum.rate, '.1f') + '%'",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 13,
        "fontWeight": 700,
        "color": "#1e2b24"
      },
      "encoding": {
        "y": {
          "field": "norm",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "text": {
          "field": "lab"
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "hi",
              "as": "hi"
            }
          ],
          "groupby": [
            "axis"
          ]
        },
        {
          "fold": [
            "hi"
          ],
          "as": [
            "end",
            "v"
          ]
        },
        {
          "calculate": "'Top ' + format(datum.v, '.1f') + '%'",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "dy": -13,
        "fontSize": 11,
        "color": "#4b5b51"
      },
      "encoding": {
        "y": {
          "datum": 1
        },
        "text": {
          "field": "lab"
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ],
          "groupby": [
            "axis"
          ]
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "dy": 14,
        "fontSize": 11,
        "color": "#4b5b51"
      },
      "encoding": {
        "y": {
          "datum": 0
        },
        "text": {
          "value": "0%"
        }
      }
    }
  ],
  "config": {
    "padding": {
      "left": 30,
      "right": 50,
      "top": 10,
      "bottom": 24
    }
  }
}

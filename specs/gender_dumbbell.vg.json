{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dumbbell chart comparing women's and men's participation in outdoor activities, 2025 (AusPlay). Two panels, both starting at 0%.",
  "data": {
    "url": "data/outdoor_activity_adults_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "rate": "number"
      }
    }
  },
  "transform": [
    {
      "filter": {
        "field": "group",
        "oneOf": [
          "Males",
          "Females"
        ]
      }
    },
    {
      "filter": {
        "field": "activity",
        "oneOf": [
          "Bush walking",
          "Cycling",
          "Surfing",
          "Fishing (recreational)",
          "Canoeing/Kayaking",
          "Mountain biking",
          "Ski & snowboard",
          "Equestrian",
          "Rock climbing/Abseiling/Caving",
          "Sailing"
        ]
      }
    },
    {
      "calculate": "datum.group == 'Females' ? 'Women' : 'Men'",
      "as": "sex"
    },
    {
      "calculate": "replace(replace(replace(replace(datum.activity, 'Bush walking', 'Bushwalking'), 'Rock climbing/Abseiling/Caving', 'Climbing & caving'), 'Fishing (recreational)', 'Fishing'), 'Equestrian', 'Horse riding')",
      "as": "label"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "rate",
          "as": "top"
        }
      ],
      "groupby": [
        "activity"
      ]
    }
  ],
  "vconcat": [
    {
      "title": {
        "text": "The two biggest activities",
        "fontSize": 13,
        "font": "Figtree, sans-serif",
        "fontWeight": 700,
        "color": "#1e2b24",
        "offset": 8
      },
      "width": 380,
      "height": {
        "step": 30
      },
      "transform": [
        {
          "filter": "datum.top >= 5"
        }
      ],
      "encoding": {
        "y": {
          "field": "label",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "top",
            "op": "max",
            "order": "descending"
          },
          "axis": {
            "domain": false,
            "ticks": false,
            "labelFontSize": 12.5,
            "grid": true,
            "gridDash": [
              2,
              3
            ],
            "minExtent": 120
          }
        },
        "x": {
          "field": "rate",
          "type": "quantitative",
          "title": "% of adults taking part",
          "scale": {
            "domain": [
              0,
              20
            ]
          },
          "axis": {
            "values": [
              0,
              5,
              10,
              15,
              20
            ]
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "line",
            "color": "#9aa79a",
            "strokeWidth": 2.5
          },
          "encoding": {
            "detail": {
              "field": "label"
            }
          }
        },
        {
          "mark": {
            "type": "point",
            "filled": true,
            "size": 110,
            "opacity": 1,
            "stroke": "#eef1ea",
            "strokeWidth": 1.5
          },
          "encoding": {
            "color": {
              "field": "sex",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "Women",
                  "Men"
                ],
                "range": [
                  "#a8462e",
                  "#2a74a8"
                ]
              },
              "legend": {
                "orient": "top",
                "direction": "horizontal",
                "symbolSize": 120,
                "labelFontSize": 13
              }
            },
            "shape": {
              "field": "sex",
              "scale": {
                "domain": [
                  "Women",
                  "Men"
                ],
                "range": [
                  "circle",
                  "diamond"
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "label",
                "title": "Activity"
              },
              {
                "field": "sex",
                "title": "Group"
              },
              {
                "field": "rate",
                "title": "% taking part",
                "format": ".2f"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "lineBreak": "\n",
            "fontSize": 12,
            "fontStyle": "italic",
            "color": "#4b5b51",
            "dx": -12,
            "dy": -12
          },
          "data": {
            "values": [
              {
                "t": "Women lead",
                "rate": 18.6,
                "label": "Bushwalking"
              }
            ]
          },
          "encoding": {
            "text": {
              "field": "t"
            }
          }
        }
      ]
    },
    {
      "title": {
        "text": "Smaller activities (shorter scale)",
        "fontSize": 13,
        "font": "Figtree, sans-serif",
        "fontWeight": 700,
        "color": "#1e2b24",
        "offset": 8
      },
      "width": 380,
      "height": {
        "step": 30
      },
      "transform": [
        {
          "filter": "datum.top < 5"
        }
      ],
      "encoding": {
        "y": {
          "field": "label",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "top",
            "op": "max",
            "order": "descending"
          },
          "axis": {
            "domain": false,
            "ticks": false,
            "labelFontSize": 12.5,
            "grid": true,
            "gridDash": [
              2,
              3
            ],
            "minExtent": 120
          }
        },
        "x": {
          "field": "rate",
          "type": "quantitative",
          "title": "% of adults taking part",
          "scale": {
            "domain": [
              0,
              2
            ]
          },
          "axis": {
            "values": [
              0,
              0.5,
              1,
              1.5,
              2
            ]
          }
        }
      },
      "layer": [
        {
          "mark": {
            "type": "line",
            "color": "#9aa79a",
            "strokeWidth": 2.5
          },
          "encoding": {
            "detail": {
              "field": "label"
            }
          }
        },
        {
          "mark": {
            "type": "point",
            "filled": true,
            "size": 110,
            "opacity": 1,
            "stroke": "#eef1ea",
            "strokeWidth": 1.5
          },
          "encoding": {
            "color": {
              "field": "sex",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "Women",
                  "Men"
                ],
                "range": [
                  "#a8462e",
                  "#2a74a8"
                ]
              },
              "legend": {
                "orient": "top",
                "direction": "horizontal",
                "symbolSize": 120,
                "labelFontSize": 13
              }
            },
            "shape": {
              "field": "sex",
              "scale": {
                "domain": [
                  "Women",
                  "Men"
                ],
                "range": [
                  "circle",
                  "diamond"
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "label",
                "title": "Activity"
              },
              {
                "field": "sex",
                "title": "Group"
              },
              {
                "field": "rate",
                "title": "% taking part",
                "format": ".2f"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "lineBreak": "\n",
            "fontSize": 12,
            "fontStyle": "italic",
            "color": "#4b5b51",
            "dx": 10,
            "dy": 2
          },
          "data": {
            "values": [
              {
                "t": "Men about four\ntimes as likely",
                "rate": 1.25,
                "label": "Mountain biking"
              }
            ]
          },
          "encoding": {
            "text": {
              "field": "t"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "lineBreak": "\n",
            "fontSize": 12,
            "fontStyle": "italic",
            "color": "#4b5b51",
            "dx": 10,
            "dy": 2
          },
          "data": {
            "values": [
              {
                "t": "Women about five\ntimes as likely",
                "rate": 0.8,
                "label": "Horse riding"
              }
            ]
          },
          "encoding": {
            "text": {
              "field": "t"
            }
          }
        }
      ]
    }
  ],
  "spacing": 28,
  "resolve": {
    "scale": {
      "color": "shared",
      "shape": "shared"
    },
    "legend": {
      "color": "shared"
    }
  }
}

{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dumbbell chart comparing women's and men's participation in outdoor activities, 2025 (AusPlay).",
  "width": "container",
  "height": 340,
  "data": {
    "url": "data/outdoor_activity_adults_2025.csv",
    "format": {
      "type": "csv",
      "parse": {
        "rate": "number"
      }
    }
  },
  "transform": [
    {
      "filter": {
        "field": "group",
        "oneOf": [
          "Males",
          "Females"
        ]
      }
    },
    {
      "filter": {
        "field": "activity",
        "oneOf": [
          "Bush walking",
          "Cycling",
          "Surfing",
          "Fishing (recreational)",
          "Canoeing/Kayaking",
          "Mountain biking",
          "Ski & snowboard",
          "Equestrian",
          "Rock climbing/Abseiling/Caving",
          "Sailing"
        ]
      }
    },
    {
      "calculate": "datum.group == 'Females' ? 'Women' : 'Men'",
      "as": "sex"
    },
    {
      "calculate": "replace(replace(replace(replace(datum.activity, 'Bush walking', 'Bushwalking'), 'Rock climbing/Abseiling/Caving', 'Climbing & caving'), 'Fishing (recreational)', 'Fishing'), 'Equestrian', 'Horse riding')",
      "as": "label"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "rate",
          "as": "top"
        }
      ],
      "groupby": [
        "activity"
      ]
    }
  ],
  "encoding": {
    "y": {
      "field": "label",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "top",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 12.5,
        "grid": true,
        "gridDash": [
          2,
          3
        ]
      }
    },
    "x": {
      "field": "rate",
      "type": "quantitative",
      "title": "% of adults taking part (log scale)",
      "scale": {
        "type": "log",
        "domain": [
          0.1,
          25
        ]
      },
      "axis": {
        "values": [
          0.1,
          0.3,
          1,
          3,
          10,
          20
        ],
        "format": "~g"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#9aa79a",
        "strokeWidth": 2.5
      },
      "encoding": {
        "detail": {
          "field": "label"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 110,
        "opacity": 1,
        "stroke": "#eef1ea",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "sex",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Women",
              "Men"
            ],
            "range": [
              "#a8462e",
              "#2a74a8"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolSize": 120,
            "labelFontSize": 13
          }
        },
        "shape": {
          "field": "sex",
          "scale": {
            "domain": [
              "Women",
              "Men"
            ],
            "range": [
              "circle",
              "diamond"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "label",
            "title": "Activity"
          },
          {
            "field": "sex",
            "title": "Group"
          },
          {
            "field": "rate",
            "title": "% taking part",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "lineBreak": "\n",
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#4b5b51",
        "dx": -10,
        "dy": 8
      },
      "data": {
        "values": [
          {
            "t": "Women lead in bushwalking\nand horse riding",
            "rate": 13,
            "label": "Bushwalking"
          }
        ]
      },
      "encoding": {
        "text": {
          "field": "t"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "lineBreak": "\n",
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#4b5b51",
        "dx": 8
      },
      "data": {
        "values": [
          {
            "t": "Men are about four times as\nlikely to mountain bike",
            "rate": 1.45,
            "label": "Mountain biking"
          }
        ]
      },
      "encoding": {
        "text": {
          "field": "t"
        }
      }
    }
  ]
}
